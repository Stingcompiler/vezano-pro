# Local Docker development settings (docker-compose.yml). Optional: every
# value below is already the default. To change any of them:
#   cp .env.docker.example .env      (/.env is git-ignored)
# Dev-only values. Never put production secrets here; production does not
# use Docker (deploy/ovh/README.md).

# Host ports (5433 avoids clashing with a local PostgreSQL on 5432).
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5433

# Local database (dev-only credentials, reachable only through the ports above).
POSTGRES_USER=vezano
POSTGRES_PASSWORD=vezano-dev-only
POSTGRES_DB=vezano

# runserver (hot reload, default) or gunicorn (the VPS process model).
VEZANO_DOCKER_MODE=runserver

# Linux only: your `id -u` / `id -g`, so files the containers write into the
# checkout stay yours. Leave at 1000 on macOS/Windows (Docker Desktop maps it).
HOST_UID=1000
HOST_GID=1000

# Node for the frontend image; 20 matches CI.
NODE_VERSION=20

# Set to true if the Next.js dev server misses file edits.
WATCHPACK_POLLING=false

# `make seed`: the local owner account (.test never routes to a real inbox).
SEED_OWNER_EMAIL=dev-owner@vezano.test
